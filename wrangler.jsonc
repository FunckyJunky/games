// Cloudflare settings for the site.
// "name" must match the project name in the Cloudflare dashboard.
{
  "name": "games",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Before every deploy: the radio track lists (tools/soundrooms.mjs) for the games' SoundRooms folders.
  "build": { "command": "node tools/soundrooms.mjs" },

  // Keep the free games.<name>.workers.dev address working too.
  "workers_dev": true,

  // The site's own domain (also set in the Cloudflare dashboard).
  "routes": [
    { "pattern": "error.blue", "custom_domain": true },
    { "pattern": "www.error.blue", "custom_domain": true }
  ],

  // Website files. /api/*, /games/* and /voyage (Leviathan) go to src/index.js first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/games/*", "/voyage", "/voyage/*", "/music3d", "/music3d/*", "/thuisfront/dev/ws"]
  },

  // Database for scores and saved progress.
  // Cloudflare creates it automatically on the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-lab-db"
    }
  ],

  // Multiplayer rooms.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "WALL", "class_name": "PixelWall" },
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "TUSA", "class_name": "TusaRoom" },
      { "name": "VGADAI", "class_name": "VgadaiRoom" },
      { "name": "ONLINE", "class_name": "OnlineBoard" },
      { "name": "HF", "class_name": "HomeFront" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PixelWall"] },
    { "tag": "v3", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["TusaRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["VgadaiRoom"] },
    { "tag": "v6", "new_sqlite_classes": ["OnlineBoard"] },
    { "tag": "v7", "new_sqlite_classes": ["HomeFront"] }
  ],

  "observability": { "enabled": true }
}
